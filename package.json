{
  "name": "dsh-whale-sensei",
  "version": "0.3.3",
  "description": "鲸师：把课程包变成可教的课程页 + 知识星图（DSH 插件）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools/upgrade-pack.mjs",
    "tools/migrate-pack.mjs",
    "preset/whale-mode/agent.cordis.yml",
    "preset/whale-mode/preset.yml",
    "preset/whale-mode/persona.md",
    "install-whale-sensei.ps1",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "ONBOARDING.md",
    "docs/capabilities.md",
    "docs/dsh-native-style.md",
    "LICENSE"
  ],
  "bin": {
    "dsh-whale-pack": "tools/upgrade-pack.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sutrasky/dsh-whale-sensei.git"
  },
  "homepage": "https://github.com/sutrasky/dsh-whale-sensei",
  "bugs": {
    "url": "https://github.com/sutrasky/dsh-whale-sensei/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "lesson",
    "course",
    "teaching"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react"
      ]
    },
    "distribution": {
      "mode": "private"
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "test:all": "node test/all.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "axe-core": "^4.14.0"
  }
}
